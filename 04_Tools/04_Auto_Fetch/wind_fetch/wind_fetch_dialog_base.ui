      <widget class="QDoubleSpinBox" name="spnInterval">
       <property name="minimum"><double>0.1</double></property>
       <property name="maximum"><double>90.0</double></property>
       <property name="value"><double>3.0</double></property>
       <property name="decimals"><number>2</number></property>
      </widget>
     </item>
     <item row="6" column="0">
      <widget class="QLabel" name="lblOutput"><property name="text"><string>Output layer name</string></property></widget>
     </item>
     <item row="6" column="1">
      <widget class="QLineEdit" name="txtOutput">
       <property name="text"><string>Wind_Fetch</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="grpEff">
     <property name="title"><string>Effective fetch (Saville / Fell et al.)</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <layout class="QFormLayout" name="effLayout">
      <item row="0" column="0">
