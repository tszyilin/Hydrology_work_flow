<ui version="4.0">
 <class>WindFetchDialogBase</class>
 <widget class="QDialog" name="WindFetchDialogBase">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>480</width><height>520</height></rect>
  </property>
  <property name="windowTitle">
   <string>Wind Fetch Calculator</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="grpMode">
     <property name="title"><string>Embankment source</string></property>
     <layout class="QVBoxLayout" name="modeLayout">
      <item>
       <widget class="QRadioButton" name="radPoint">
        <property name="text"><string>Point layer (single location)</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="radLine">
        <property name="text"><string>Line layer (sample along crest)</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="lblPoint"><property name="text"><string>Embankment point layer</string></property></widget>
     </item>
     <item row="0" column="1">
      <widget class="QgsMapLayerComboBox" name="cmbPointLayer"/>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="lblLine"><property name="text"><string>Embankment line layer</string></property></widget>
     </item>
     <item row="1" column="1">
      <widget class="QgsMapLayerComboBox" name="cmbLineLayer"/>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="lblSpacing"><property name="text"><string>Sample spacing (m)</string></property></widget>
     </item>
     <item row="2" column="1">
      <widget class="QDoubleSpinBox" name="spnSpacing">
       <property name="minimum"><double>0.1</double></property>
       <property name="maximum"><double>10000.0</double></property>
       <property name="value"><double>20.0</double></property>
       <property name="decimals"><number>1</number></property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="lblPoly"><property name="text"><string>Water body polygon layer</string></property></widget>
     </item>
     <item row="3" column="1">
      <widget class="QgsMapLayerComboBox" name="cmbPolyLayer"/>
     </item>
     <item row="4" column="0">
      <widget class="QLabel" name="lblRadius"><property name="text"><string>Fetch radius (m)</string></property></widget>
     </item>
     <item row="4" column="1">
      <widget class="QDoubleSpinBox" name="spnRadius">
       <property name="minimum"><double>1.0</double></property>
       <property name="maximum"><double>100000.0</double></property>
       <property name="value"><double>2000.0</double></property>
       <property name="decimals"><number>1</number></property>
      </widget>
     </item>
